      - name: Add company certificate
        env:
          CA_CERT: ${{ github.event.inputs.ca_cert }}
        run: |
          if [ -n "$CA_CERT" ]; then
            echo "$CA_CERT" | tr -d ' \r\n' | grep -Eq '^[A-Za-z0-9+/=]+$' || { echo "Invalid certificate text"; exit 1; }
            mkdir -p android/app/src/main/res/raw
            echo "$CA_CERT" | tr -d ' \r\n' | base64 -d > android/app/src/main/res/raw/signage_ca.cer
            openssl x509 -inform der -in android/app/src/main/res/raw/signage_ca.cer -noout -subject
            sed -i 's|<!--SIGNAGE_CA-->|<certificates src="@raw/signage_ca" />|' android/app/src/main/res/xml/network_security_config.xml
          fi

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.9"

      - name: Build APK
        working-directory: android
        env:
          SERVER_URL: ${{ github.event.inputs.server_url }}
        run: gradle assembleRelease -PSERVER_URL="$SERVER_URL"

      - name: Rename APK
        run: cp android/app/build/outputs/apk/release/app-release.apk signage-player.apk

      - uses: actions/upload-artifact@v4
        with:
          name: signage-player-apk
          path: signage-player.apk
